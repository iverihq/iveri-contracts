{
  "name": "@iveri/contracts",
  "version": "0.72.0",
  "description": "Wire contracts shared by every Iveri backend and frontend. Zero runtime dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iverihq/iveri-contracts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conduit": {
      "types": "./dist/api/conduit/index.d.ts",
      "default": "./dist/api/conduit/index.js"
    },
    "./identity": {
      "types": "./dist/api/identity/index.d.ts",
      "default": "./dist/api/identity/index.js"
    },
    "./unibox": {
      "types": "./dist/api/unibox/index.d.ts",
      "default": "./dist/api/unibox/index.js"
    },
    "./unibox-ai": {
      "types": "./dist/api/unibox-ai/index.d.ts",
      "default": "./dist/api/unibox-ai/index.js"
    },
    "./localization": {
      "types": "./dist/api/localization/index.d.ts",
      "default": "./dist/api/localization/index.js"
    },
    "./notification": {
      "types": "./dist/api/notification/index.d.ts",
      "default": "./dist/api/notification/index.js"
    },
    "./realtime": {
      "types": "./dist/api/realtime/index.d.ts",
      "default": "./dist/api/realtime/index.js"
    },
    "./clinic": {
      "types": "./dist/api/clinic/index.d.ts",
      "default": "./dist/api/clinic/index.js"
    },
    "./chat": {
      "types": "./dist/api/chat/index.d.ts",
      "default": "./dist/api/chat/index.js"
    },
    "./social": {
      "types": "./dist/api/social/index.d.ts",
      "default": "./dist/api/social/index.js"
    },
    "./hr": {
      "types": "./dist/api/hr/index.d.ts",
      "default": "./dist/api/hr/index.js"
    },
    "./restaurant": {
      "types": "./dist/api/restaurant/index.d.ts",
      "default": "./dist/api/restaurant/index.js"
    },
    "./gym": {
      "types": "./dist/api/gym/index.d.ts",
      "default": "./dist/api/gym/index.js"
    },
    "./mobility": {
      "types": "./dist/api/mobility/index.d.ts",
      "default": "./dist/api/mobility/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node ./scripts/verify-zero-runtime-deps.mjs && node ./scripts/verify-entry-points.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@iveri/prettier-config",
  "devDependencies": {
    "@iveri/eslint-config": "^0.2.3",
    "@iveri/prettier-config": "^0.1.0",
    "@iveri/tsconfig": "^0.2.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
